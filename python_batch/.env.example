# Application
APP_NAME=PythonBatchSystem
APP_ENV=development
DEBUG=true

# Laravel API
LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_API_TOKEN=

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Scraping
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPING_TIMEOUT=30
SCRAPING_RETRY_COUNT=3
SCRAPING_CONCURRENT_REQUESTS=5

# File Processing
UPLOAD_DIR=../new_repository/storage/app/uploads
TEMP_DIR=./data/temp
MAX_FILE_SIZE=10485760

# Reporting
REPORT_OUTPUT_DIR=./reports
REPORT_FORMAT=html,pdf,excel

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/batch.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# External APIs
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT=60

# Monitoring
SENTRY_DSN=
ENABLE_MONITORING=false

# Scheduler
SCHEDULER_TIMEZONE=Asia/Tokyo
ENABLE_SCHEDULER=true
