{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:prod": "NODE_ENV=production vite build",
        "preview": "vite preview",
        "clean": "rm -rf public/build",
        "rebuild": "npm run clean && npm run build",
        "watch": "vite build --watch",
        "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint resources/js --ext .js,.jsx,.ts,.tsx --fix",
        "format": "prettier --write 'resources/**/*.{js,jsx,ts,tsx,css,scss}'",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "analyze": "vite build --mode analyze"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.1",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "^25.9.3",
        "@vitejs/plugin-react": "^6.0.2",
        "autoprefixer": "^10.5.0",
        "axios": "^1.18.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.4.1",
        "laravel-vite-plugin": "^3.0.0",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "rollup-plugin-visualizer": "^7.0.1",
        "sass": "^1.101.0",
        "tailwindcss": "^4.3.1",
        "terser": "^5.48.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-compression": "^0.5.1",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@inertiajs/react": "^3.3.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
